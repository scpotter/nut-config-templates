# Template for host_config.env — copy this file to host_config.env
# (gitignored, never committed) and fill in real values.
#
# This repo's public interface: launch.sh sources ./host_config.env for
# the Infisical folder names + device IPs (private config, not secrets) and
# pulls the real secrets — upsd account passwords and the two SNMP write
# communities — from Infisical at launch. Where host_config.env's values
# come from is up to you: hardcode them here, or generate this file from a
# private config store on your own infrastructure. This repo doesn't care.
#
# The Infisical machine identity's own bootstrap credential goes in
# ~/.secrets/infisical.env (NOT here, NOT in git) as two vars whose names
# are the SCREAMING_SNAKE transform of the identity name — this operator's
# identity is `launch-NutRack`, so LAUNCH_NUT_RACK_CLIENT_ID /
# LAUNCH_NUT_RACK_CLIENT_SECRET. A forker with a different identity name
# edits the matching two lines in launch.sh.

# Infisical folder that holds THIS NUT server's upsd accounts
# (core-infra project). It has two subfolders, `monitor` and `padmin`,
# each with TOKEN_NAME + TOKEN_SECRET. Naming it per-server keeps a second
# NUT server from colliding under a shared folder.
SERVER=nut_rack

# core-infra subfolders under /apc_snmp/ for each device's SNMP community
# (one bare COMMUNITY key each), plus the device IPs.
UPS_DEVICE=rack_ups
PDU_DEVICE=pdu7920
UPS_IP=10.0.21.178
PDU_IP=10.0.21.108

# Self-hosted Infisical instance and the core-infra project's ID (UUID).
INFISICAL_API_URL=https://your-infisical-instance
CORE_INFRA_PROJECT_ID=your-core-infra-project-id
