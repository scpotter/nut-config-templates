#!/bin/bash
#
# NUT-driven load shedding for the APC PDU.
#
# Rendered to /etc/nut/loadshed.sh by ../launch.sh (mode 0700 — it embeds
# the PDU's write community). RENDER_PDU_IP and RENDER_PDU_COMMUNITY are
# substituted at render time; everything else is committed as-is.
#
# Invoked by /etc/nut/notify.sh on every upsmon power event. MINIMAL and LOW
# are implemented against real outlets; HIGH / CRITICAL / CORE are
# placeholder log lines. Completing them, and independently verifying the
# outlet map (7,8 / 5,6), is future work — see the slice-5 plan and
# infra-gaps-log.md. The outlet assignments below were carried forward
# unverified, at the operator's explicit acceptance of that risk.

UPS="rack_UPS@localhost"
PDU_IP="${RENDER_PDU_IP}"
COMMUNITY="${RENDER_PDU_COMMUNITY}"

# Outlet groups
MINIMAL=(7 8)   # shed <90%, restore >=80%
LOW=(5 6)       # shed <80%, restore >=40%

# Future tiers (no outlets yet)
HIGH=()
CRITICAL=()
CORE=()

# APC sPDUOutletCtlOutletCommand: 1 = on, 2 = off
OID_BASE=".1.3.6.1.4.1.318.1.1.4.4.2.1.3"

pdu_set() {
    local outlet=$1
    local state=$2
    snmpset -v1 -c "$COMMUNITY" "$PDU_IP" "${OID_BASE}.${outlet}" i "$state" >/dev/null
}

BATTERY=$(upsc "$UPS" battery.charge 2>/dev/null)
STATUS=$(upsc "$UPS" ups.status 2>/dev/null)

logger -t nut-loadshed "status=$STATUS, battery=${BATTERY}%"

if [ -z "$BATTERY" ] || [ -z "$STATUS" ]; then
    logger -t nut-loadshed "ERROR: Could not read UPS values!"
    exit 1
fi

# On battery -> progressive shedding
if echo "$STATUS" | grep -q "OB"; then
    [ "$BATTERY" -lt 90 ] && for o in "${MINIMAL[@]}"; do pdu_set "$o" 2; done
    [ "$BATTERY" -lt 80 ] && for o in "${LOW[@]}";     do pdu_set "$o" 2; done
    [ "$BATTERY" -lt 40 ] && logger -t nut-loadshed "Tier HIGH: trigger shutdowns here"
    [ "$BATTERY" -lt 20 ] && logger -t nut-loadshed "Tier CRITICAL: trigger shutdowns here"
fi

# On line power -> conditional restore
if echo "$STATUS" | grep -q "OL"; then
    if [ "$BATTERY" -ge 80 ]; then
        for o in "${MINIMAL[@]}"; do pdu_set "$o" 1; done
    fi
    if [ "$BATTERY" -ge 40 ]; then
        for o in "${LOW[@]}"; do pdu_set "$o" 1; done
    fi
    if [ "$BATTERY" -ge 20 ]; then
        logger -t nut-loadshed "Tier HIGH: safe to restore"
    fi
    logger -t nut-loadshed "Tier CRITICAL: safe to restore"
fi
